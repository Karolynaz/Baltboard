<?xml version="1.0" encoding="utf-8"?>
<lt.klaviatura.advanced.AdvancedLtClipboardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advanced_lt_clipboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF09090A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FF1C1C1E">

            <LinearLayout
                android:id="@+id/advanced_lt_clipboard_normal_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/advanced_lt_clipboard_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/advanced_lt_clipboard_back_to_keyboard"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/advanced_lt_ic_keyboard"
                    android:tint="#FFFFFFFF" />

                <View
                    android:id="@+id/advanced_lt_clipboard_separator"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/advanced_lt_toolbar_clipboard"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp" />

                <ImageButton
                    android:id="@+id/advanced_lt_clipboard_start_delete"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/advanced_lt_clipboard_choose_to_delete"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/advanced_lt_ic_delete"
                    android:tint="#FFFFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/advanced_lt_clipboard_selection_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/advanced_lt_clipboard_cancel_selection"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/advanced_lt_clipboard_cancel_selection"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/advanced_lt_ic_arrow_back"
                    android:tint="#FFFFFFFF" />

                <View
                    android:id="@+id/advanced_lt_clipboard_selection_separator"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:id="@+id/advanced_lt_clipboard_select_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/advanced_lt_clipboard_all"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/advanced_lt_clipboard_selected_count"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/advanced_lt_clipboard_count_separator"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:id="@+id/advanced_lt_clipboard_delete_selected"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/advanced_lt_clipboard_delete"
                    android:textColor="#FFFC6B6B"
                    android:textSize="18sp" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/advanced_lt_clipboard_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:padding="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/advanced_lt_clipboard_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/advanced_lt_clipboard_empty"
                android:textColor="#FFB9B9BD"
                android:textSize="18sp" />

            <View
                android:id="@+id/advanced_lt_clipboard_bottom_fade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/advanced_lt_clipboard_bottom_fade"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/advanced_lt_clipboard_delete_confirmation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:background="@drawable/advanced_lt_clipboard_confirmation_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/advanced_lt_clipboard_delete_confirmation_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/advanced_lt_clipboard_delete_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/advanced_lt_clipboard_cancel"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/advanced_lt_clipboard_confirmation_separator"
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:id="@+id/advanced_lt_clipboard_delete_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/advanced_lt_clipboard_delete"
                    android:textColor="#FFFC6B6B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</lt.klaviatura.advanced.AdvancedLtClipboardView>
