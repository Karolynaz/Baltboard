<?xml version="1.0" encoding="utf-8"?>
<com.anysoftkeyboard.quicktextkeys.ui.QuickTextPagerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_text_pager_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/quick_text_category_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/quick_keys_popup_close"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/close_button"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/advanced_lt_ic_keyboard" />

        <View
            android:id="@+id/quick_text_category_separator"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#40FFFFFF" />

        <HorizontalScrollView
            android:id="@+id/quick_text_category_scroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quick_text_category_tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <net.evendanan.pixel.ViewPagerWithDisable
        android:id="@+id/quick_text_keyboards_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <View
        android:id="@+id/quick_text_bottom_fade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="@drawable/advanced_lt_clipboard_bottom_fade"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />
    </FrameLayout>
</com.anysoftkeyboard.quicktextkeys.ui.QuickTextPagerView>
